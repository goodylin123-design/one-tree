# 上線前請換成一長串隨機字。更換後需刪除 data/db.json 重新建立，舊的驗證碼才解得開。
SESSION_SECRET=please-change-this-to-a-long-random-string

# QR code 連到這個網址。手機掃碼時請改成手機連得到的位址，不要用 localhost。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 訂房頁與 LINE 官方帳號確認後再填。沒填時，「預約回訪」會改走電話與 Email。
# NEXT_PUBLIC_BOOKING_URL=
# NEXT_PUBLIC_LINE_URL=

# 設為 true 時，正式環境的首頁也會顯示開發試用編號。
# NEXT_PUBLIC_SHOW_DEMO=true
